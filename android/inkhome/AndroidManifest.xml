<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.meebook.inkhome" android:versionCode="20" android:versionName="2.12">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="30" />
    <!-- Android 11 package visibility: a launcher must see every app -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- read KOReader favourites and book files for covers -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Home Control talks to the Smart Life (Tuya) and Dreo clouds -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="InkHome" android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">
        <activity android:name=".MainActivity"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="nosensor" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:label="Settings"
            android:icon="@android:drawable/ic_menu_preferences"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:taskAffinity="com.meebook.inkhome.settings"
            android:exported="true">
            <!-- own task: in the home task, singleTask + clearTaskOnLaunch on MainActivity
                 cleared it straight away, so tapping the icon just showed home again -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeControlActivity" android:label="Home Control"
            android:icon="@android:drawable/ic_menu_myplaces"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:taskAffinity="com.meebook.inkhome.homecontrol"
            android:screenOrientation="nosensor" android:exported="true">
            <!-- own task, for the same reason as SettingsActivity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Look Up: KOReader's "define:" and "Ask AI" buttons open inklook://search?q= / inklook://ask?q= -->
        <activity android:name=".LookUpActivity" android:label="Look Up"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:taskAffinity="com.meebook.inkhome.lookup"
            android:launchMode="singleTask" android:excludeFromRecents="true"
            android:screenOrientation="nosensor" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inklook" />
            </intent-filter>
        </activity>
    </application>
</manifest>
